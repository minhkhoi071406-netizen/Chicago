local function cleanESP(plr)
    if espCache[plr] then
        if espCache[plr].Box then espCache[plr].Box:Remove() end
        if espCache[plr].Tracer then espCache[plr].Tracer:Remove() end
        if espCache[plr].Billboard then espCache[plr].Billboard:Destroy() end
        espCache[plr] = nil
    end
end

-- ==================== HÀM KIỂM TRA MỤC TIÊU ====================
local function isPartVisible(targetPart, character)
    local origin = Camera.CFrame.Position
    local destination = targetPart.Position
    local direction = destination - origin

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = RaycastFilterType.Exclude
    
    local ignoreList = {Camera}
    if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
    if character then table.insert(ignoreList, character) end
    
    raycastParams.FilterDescendantsInstances = ignoreList
    raycastParams.IgnoreWater = true

    local result = Workspace:Raycast(origin, direction, raycastParams)
    return result == nil
end

local function getClosestTarget()
    local closestTarget = nil
    local shortestDist = math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not skippedPlayers[plr] and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChildOfClass("Humanoid") and plr.Character.Humanoid.Health > 0 then
            local head = plr.Character.Head
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local dist = (Vector2.new(myRoot.Position.X, myRoot.Position.Z) - Vector2.new(head.Position.X, head.Position.Z)).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestTarget = head
                end
            end
        end
    end
    return closestTarget
end

-- ==================== 1. SPEEDRUN & NOCLIP ====================
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        
        if humanoid and root and speedRunEnabled then
            if humanoid.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + (humanoid.MoveDirection * (20 * 0.05))
            end
        end

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                if noclipEnabled or killAllFlyEnabled then
                    if originalCanCollide[part] == nil then
                        originalCanCollide[part] = part.CanCollide
                    end
                    part.CanCollide = false
                else
                    if originalCanCollide[part] ~= nil then
                        part.CanCollide = originalCanCollide[part]
                        originalCanCollide[part] = nil
                    end
                end
            end
        end
    end
end)

-- ==================== 2. KILL ALL FLY (BAY NGANG TRÊN TRỜI ĐẾN ĐỊCH) ====================
RunService.Heartbeat:Connect(function(deltaTime)
    if killAllFlyEnabled then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if root then
            root.Velocity = Vector3.new(0, 0, 0)
            local targetHead = getClosestTarget()
            
            local targetX = root.Position.X
            local targetZ = root.Position.Z
            
            if targetHead then
                targetX = targetHead.Position.X
                targetZ = targetHead.Position.Z
                -- Xoay Camera nhắm vào đầu đối thủ
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
            end
            
            local targetPos = Vector3.new(targetX, skyHeight, targetZ)
            local currentPos = Vector3.new(root.Position.X, skyHeight, root.Position.Z)
            
            local direction = (targetPos - currentPos)
            if direction.Magnitude > 1 then
                local moveStep = direction.Unit * (flySpeed * deltaTime)
                if moveStep.Magnitude > direction.Magnitude then
                    moveStep = direction
                end
                root.CFrame = CFrame.new(currentPos + moveStep)
            else
                root.CFrame = CFrame.new(targetPos)
            end
        end
    end
end)

